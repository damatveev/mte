{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-mail-template-editor" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}

    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-envelope"></i> {{ heading_title }}</h3></div>
      <div class="panel-body">
        <div class="row">
          <div class="col-sm-3">
            <div class="list-group">
              <div class="list-group-item active">{{ text_language_files }}</div>
              {% for file in language_files %}
                <a href="{{ file.href }}" class="list-group-item{% if kind == 'language' and selected_id == file.id %} active{% endif %}">{{ file.label }}</a>
              {% else %}
                <div class="list-group-item">{{ text_no_files }}</div>
              {% endfor %}
            </div>

            <div class="list-group">
              <div class="list-group-item active">{{ text_template_files }}</div>
              {% for file in template_files %}
                <a href="{{ file.href }}" class="list-group-item{% if kind == 'template' and selected_id == file.id %} active{% endif %}">{{ file.label }}</a>
              {% else %}
                <div class="list-group-item">{{ text_no_files }}</div>
              {% endfor %}
            </div>
          </div>

          <div class="col-sm-9">
            {% if selected %}
            <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-mail-template-editor" class="form-horizontal">
              <div class="alert alert-info"><i class="fa fa-info-circle"></i> {{ text_backup }}<br>{{ text_variables }}</div>
              <h4>{{ selected.label }}</h4>

              {% if kind == 'language' %}
                {% for key, value in values %}
                <div class="form-group">
                  <label class="col-sm-3 control-label" for="input-{{ key }}">{{ key }}</label>
                  <div class="col-sm-9">
                    <textarea name="values[{{ key }}]" rows="3" id="input-{{ key }}" class="form-control">{{ value }}</textarea>
                    {% if value_placeholders[key] is defined and value_placeholders[key] %}
                    <p class="help-block"><strong>{{ text_required_variables }}:</strong>
                      {% for variable in value_placeholders[key] %}<code>{{ variable }}</code> {% endfor %}
                    </p>
                    {% endif %}
                  </div>
                </div>
                {% endfor %}
              {% else %}
                <div class="alert {% if selected.mail_type == 'html' %}alert-success{% elseif selected.mail_type == 'text' %}alert-warning{% else %}alert-info{% endif %}">
                  <strong>{{ text_mail_type }}:</strong>
                  {% if selected.mail_type == 'html' %}
                    {{ text_mail_type_html }}<br><small>{{ text_html_editor_hint }}</small>
                  {% elseif selected.mail_type == 'text' %}
                    {{ text_mail_type_text }}<br><small>{{ text_plain_editor_hint }}</small>
                  {% else %}
                    {{ text_mail_type_unknown }}
                  {% endif %}
                </div>
                {% if template_placeholders %}
                <div class="well well-sm">
                  <strong>{{ text_required_variables }}:</strong><br>
                  {% for variable in template_placeholders %}<code>{{ variable }}</code> {% endfor %}
                </div>
                {% endif %}
                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-content">{{ entry_template }}</label>
                  <div class="col-sm-10">
                    <textarea name="content" rows="28" id="input-content" class="form-control mail-template-editor" style="font-family:monospace;" data-editor-fallback="summernote" data-mail-type="{{ selected.mail_type|default('unknown') }}">{{ content }}</textarea>
                  </div>
                </div>
              {% endif %}
              <hr>
              <p class="text-muted"><small>{{ text_author }}</small></p>
              <div class="well well-sm" style="margin-top:10px;">
                <div class="row">
                  <div class="col-sm-9">
                    <p style="margin-bottom:8px;">
                      <i class="fa fa-heart"></i> {{ text_donate }} —
                      <a href="{{ text_donate_url }}" target="_blank" rel="noopener noreferrer"><strong>{{ text_donate_link }}</strong></a>
                    </p>
                    <p class="text-muted" style="margin-bottom:0;">
                      <small>{{ text_donate_url }}</small>
                    </p>
                  </div>
                  <div class="col-sm-3 text-center">
                    <a href="{{ text_donate_url }}" target="_blank" rel="noopener noreferrer" title="{{ text_donate_link }}">
                      <img src="view/image/mail_template_editor/donate.png"
                           alt="{{ text_donate_qr }}"
                           width="140"
                           height="140"
                           style="max-width:100%;height:auto;border:1px solid #ddd;background:#fff;padding:6px;">
                    </a>
                    <div class="text-muted"><small>{{ text_donate_qr }}</small></div>
                  </div>
                </div>
              </div>
            </form>
            {% else %}
              <div class="alert alert-warning">{{ text_no_files }}</div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{{ footer }}

<script type="text/javascript">
(function($) {
    'use strict';

    function hasOtherEditor(textarea) {
        var id = textarea.id;

        // CKEditor 4
        if (window.CKEDITOR && CKEDITOR.instances && CKEDITOR.instances[id]) {
            return true;
        }

        // TinyMCE
        if (window.tinymce && typeof window.tinymce.get === 'function' && window.tinymce.get(id)) {
            return true;
        }

        // CodeMirror wrappers commonly added by extensions
        if ($(textarea).next('.CodeMirror').length || $(textarea).parent().find('> .CodeMirror').length) {
            return true;
        }

        // Already initialized Summernote
        if ($(textarea).next('.note-editor').length || $(textarea).data('summernote')) {
            return true;
        }

        // Generic markers used by third-party editor modules
        if ($(textarea).is('[data-editor-active="1"], .editor-initialized, .wysiwyg-initialized')) {
            return true;
        }

        return false;
    }

    function initFallbackEditor() {
        var textarea = document.getElementById('input-content');

        if (!textarea || hasOtherEditor(textarea)) {
            return;
        }

        // Summernote is only appropriate when the actual mail transport uses setHtml().
        if ($(textarea).attr('data-mail-type') !== 'html') {
            return;
        }

        if ($.fn && typeof $.fn.summernote === 'function') {
            $(textarea).summernote({
                height: 420,
                disableDragAndDrop: true,
                toolbar: [
                    ['style', ['style']],
                    ['font', ['bold', 'italic', 'underline', 'clear']],
                    ['fontname', ['fontname']],
                    ['fontsize', ['fontsize']],
                    ['color', ['color']],
                    ['para', ['ul', 'ol', 'paragraph']],
                    ['insert', ['link', 'picture', 'table', 'hr']],
                    ['view', ['fullscreen', 'codeview', 'help']]
                ],
                callbacks: {
                    onInit: function() {
                        $(textarea).attr('data-mail-template-editor', 'summernote');
                    }
                }
            });
        }
    }

    $(function() {
        // Give third-party modules a chance to initialize their own editor first.
        window.setTimeout(initFallbackEditor, 300);
    });

    $('#form-mail-template-editor').on('submit', function() {
        var textarea = $('#input-content');

        if (textarea.length && textarea.attr('data-mail-template-editor') === 'summernote' && $.fn.summernote) {
            textarea.val(textarea.summernote('code'));
        }
    });
})(jQuery);
</script>
